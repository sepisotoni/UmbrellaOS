# Server-side only — never prefixed with NEXT_PUBLIC_, never sent to the
# browser. Every backend fetch (session exchange, /auth/me, capability
# invokes made on behalf of a server component) goes through this.
UMBRELLA_CORE_API_URL=http://localhost:8000

# Must exactly match a redirect URI registered on the Discord application,
# and is passed verbatim to both POST /api/v1/auth/discord/authorize and
# POST /api/v1/auth/discord/callback (services/discord_service.py validates
# the same redirect_uri was used for both legs of the exchange).
DASHBOARD_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Cookie signing is not needed here — the cookie's value IS the opaque
# session token umbrella-core already issues (secrets.token_urlsafe(32));
# Next.js just stores it httpOnly and forwards it as a Bearer header. No
# separate dashboard-side secret to configure.
