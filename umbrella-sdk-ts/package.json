{
  "name": "@umbrellaos/sdk",
  "version": "0.1.0",
  "description": "Generated TypeScript client for the UmbrellaOS public REST API (capability invoke + introspection).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate-types": "openapi-typescript ./openapi.json -o ./src/generated-types.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED",
  "private": false
}
