<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.umbrellaos</groupId>
    <artifactId>umbrellaos-plugin</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>UmbrellaOS Minecraft Plugin</name>
    <description>
        Paper plugin bridging a Minecraft server to umbrella-core.
        Phase 13, Step 1: scaffold, CoreApiClient, HeartbeatManager, ConfigManager.
        Phase 13, Step 2: CommandPoller (command-queue round trip), BanEnforcer
        (join-time ban enforcement).
        Phase 13, Step 3: GrimBridge — real compile-time GrimAC EventBus integration,
        softdepend so server loads without GrimAC, flags reported to POST /api/v1/anticheat/flag.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.api.version>1.20.4-R0.1-SNAPSHOT</paper.api.version>
        <grimapi.version>1.1.0.0</grimapi.version>
        <json.version>20240303</json.version>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.14.2</mockito.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- GrimAC API — separate stable artifact published to their snapshots repo. -->
        <repository>
            <id>grim-snapshots</id>
            <url>https://repo.grim.ac/snapshots</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API: compile against it, but it's provided by the server at runtime -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Small, dependency-free JSON lib for building/parsing core's request/response
             bodies. Shaded + relocated below so it can't clash with another plugin's
             copy on the same server classpath. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>

        <!-- GrimAC API — provided at runtime by GrimAC itself on the server.
             Using a real compile-time dep (not reflection) so a wrong class or
             method name fails the build immediately rather than silently
             no-op-ing in production.
             GrimAPI is the separate stable API artifact (not the full grimac jar).
             Upgraded from grimac:2.3.73 to GrimAPI:1.1.0.0 targeting 26.2 support. -->
        <dependency>
            <groupId>ac.grim.grimac</groupId>
            <artifactId>GrimAPI</artifactId>
            <version>${grimapi.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Java 17+ restricts reflective access to JDK internals.
                         Mockito/ByteBuddy needs these opens to mock JDK classes
                         (e.g. HttpClient) on Java 25. -->
                    <argLine>
                        --add-opens java.base/java.net=ALL-UNNAMED
                        --add-opens java.net.http/jdk.internal.net.http=ALL-UNNAMED
                        -Dnet.bytebuddy.experimental=true
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- Shade + relocate org.json so it can't collide with another
                     plugin's copy on the same server. Paper API itself is left
                     un-shaded (provided at runtime by the server). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>org.json</pattern>
                                    <shadedPattern>com.umbrellaos.plugin.libs.json</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
