ADMIN_KEY=umbrella-admin-key-local
# Plugin API key — used by the Minecraft plugin (X-Plugin-Key header).
# This is a SEPARATE secret from ADMIN_KEY. The plugin has no admin-key
# credential and cannot call admin-key-protected endpoints. Set both to
# different values in production. See config/settings.py: secret_key.
SECRET_KEY=umbrella-plugin-key-local
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_BOT_TOKEN=your_bot_token_here
INITIAL_ADMIN_DISCORD_ID=your_discord_id_here

# Phase 9 - threat detection thresholds (all optional, sane defaults in
# config/settings.py; uncomment to override)
# THREAT_DETECTION_WINDOW_SECONDS=300
# THREAT_DETECTION_AUTH_FAILURE_THRESHOLD=5
# THREAT_DETECTION_RATE_LIMIT_THRESHOLD=10
# THREAT_DETECTION_ALERT_COOLDOWN_SECONDS=900

# Phase 9 - tracing (all optional; unset/false means spans are still
# created in-process but nothing is exported anywhere - see
# services/tracing_service.py)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_CONSOLE_EXPORT=true
